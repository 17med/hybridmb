# Copy to .env (git-ignored) and fill in from your Appwrite Cloud console.
# All variables are required at boot; the app refuses to start if one is missing.

# Appwrite Cloud API endpoint for your project's region, e.g. https://<REGION>.cloud.appwrite.io/v1
VITE_APPWRITE_ENDPOINT=
# Project ID from Appwrite console > Settings
VITE_APPWRITE_PROJECT_ID=
# Database holding the chat tables (see docs/APPWRITE_SETUP.md)
VITE_APPWRITE_DATABASE_ID=
# Table storing chat messages
VITE_APPWRITE_MESSAGES_TABLE_ID=
# Table storing one presence row per user (online / typing)
VITE_APPWRITE_PRESENCE_TABLE_ID=
