<?xml version='1.0' encoding='utf-8'?>
<widget id="com.ahmed.hypbridchat" version="0.0.1" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>HypbridChat</name>
    <description>Realtime single-room chat (Ionic React + Appwrite).</description>
    <!-- Required by cordova-electron; the email becomes the .deb Maintainer field. Placeholder: replace with a project address. -->
    <author email="maintainer@hypbridchat.invalid" href="https://github.com">HypbridChat</author>
    <content src="index.html" />
    <!-- Pin the WebView origin to https://localhost so it matches the Appwrite Web platform hostname "localhost". -->
    <preference name="Scheme" value="https" />
    <preference name="Hostname" value="localhost" />
    <!-- Appwrite Cloud REST + realtime websocket; other navigation stays blocked. -->
    <access origin="https://*.cloud.appwrite.io" />
    <access origin="wss://*.cloud.appwrite.io" />
    <allow-intent href="https://*/*" />
    <platform name="android">
        <!-- Draw behind the status and navigation bars. Without this, cordova-android shrinks the WebView below
             solid system-bar strips and env(safe-area-inset-*) is always 0. The web layer clears the bars with
             Ionic's --ion-safe-area-* (toolbars, src/pages/Auth.css, src/pages/ChatRoom.css). Trade-off: the
             status-bar icons then follow the system theme (dark in light mode), so whatever sits under them
             must follow the theme as well. -->
        <preference name="AndroidEdgeToEdge" value="true" />
    </platform>
    <platform name="electron">
        <!-- Electron cannot register the reserved "https" scheme set above. Appwrite rejects arbitrary
             custom schemes ("Invalid Scheme ... app://localhost"); "appwrite-linux" is the scheme it
             accepts once a Linux platform is registered in the Appwrite project (docs/APPWRITE_SETUP.md). -->
        <preference name="Scheme" value="appwrite-linux" />
        <preference name="Hostname" value="localhost" />
    </platform>
</widget>
